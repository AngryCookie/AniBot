# Core
DISCORD_TOKEN=replace_me
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Web panel / OAuth
SESSION_SECRET=replace_with_long_random_secret_at_least_24_chars
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace_with_generated_fernet_key
READONLY_API_KEY=

# Session/Cookie tuning
SESSION_COOKIE_NAME=anibot_session
SESSION_MAX_AGE_SECONDS=2592000
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=false
# Comma-separated list; required when web/API are on different origins and cookies must be sent cross-origin.
CORS_ALLOWED_ORIGINS=

# Optional runtime overrides
WEB_BASE_URL=http://localhost:8000
REPORTS_NOW=
MONTHLY_GOALS_NOW=
